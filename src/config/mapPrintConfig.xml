<?xml version="1.0" encoding="utf-8" ?>
<!-- $Rev: 25012 $ -->
<!-- Configuration de l'impression des plans -->
<MapPrintConfig>
    <Factor>1.5</Factor><!-- Facteur d'agrandissement du plan par rapport à l'étendue de la parcelle -->
    <Width>174.0</Width><!-- Largeur des plans (mm) -->
    <Height>99.0</Height><!-- Hauteur des plans (mm) -->
    <Scales>500,1000,1500,2000,2500,3000,3500,4000,4500,5000,7500,10000,12500,15000,25000,50000,100000,250000</Scales><!-- Liste des échelles à utiliser pour définir l'étendue d'un plan -->
    <Dpi>300</Dpi><!-- dpi utilisé pour imprimer le plan (PDF) -->
    <!-- Paramètres de la barre d'échelle -->
    <ScaleBar>
        <TopLeftPoint>4.0,92.0</TopLeftPoint><!-- Position du point gauche-haut de la barre (x,y en mm) -->
        <Width>30.0</Width><!-- Largeur maximum de la barre (mm) -->
        <Height>2.0</Height><!-- Hauteur mm de la barre (mm) -->
    </ScaleBar>
    <!-- Paramètres de la flèche Nord -->
    <NorthArrow>
        <TopCenterPoint>20.0,76.0</TopCenterPoint><!-- Position du point central-haut de la flèche (x,y en mm) -->
        <Scale>0.6</Scale><!-- Echelle de redimensionnement de la flèche -->
        <AlignWithScaleBar>V</AlignWithScaleBar><!-- Position relative par rapport à la barre d'échelle, H: centré horizontalement, V: centré verticalement-->
    </NorthArrow>
</MapPrintConfig>