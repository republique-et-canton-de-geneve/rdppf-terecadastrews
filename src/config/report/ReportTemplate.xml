<?xml version="1.0" encoding="utf-8" ?>
<!-- $Rev: 30309 $ -->
<Template>
	<!-- Marges utilisées pour le contenu du rapport (en mm), haut, droite, bas, gauche séparées par des virgules, sans espace -->
	<Margins>38,18,18,18</Margins>
	<!-- Enlever 2 à la marge du haut -->
  <!-- Police utilisée pour la barre d'échelle sur le plan -->
  <Font>Cadastra</Font>
  <!-- Polices utilisées pour les zones de texte et le glossaire (noms des fichiers dans répertoire ./config/report) -->
  <RegularFontFile>Cadastra-Regular.ttf</RegularFontFile>
  <BoldFontFile>Cadastra-Bold.ttf</BoldFontFile>
	<!-- Contenu du pied-de-page (date + référence) -->
	<Reference>
		<!-- Taille de la police -->
		<FontSize>6</FontSize>
		<!-- Format de la date -->
		<DateFormat>dd.MM.yyyy</DateFormat>
		<!-- Format de l'heure -->
		<TimeFormat>HH:mm:ss</TimeFormat>
		<!-- Espacement entre valeurs (en mm) -->
		<Spacing>2.4</Spacing>
		<!-- Alignement du text, valeurs possibles: left, center, right -->
		<Alignement>left</Alignement>
		<!-- Positionnement, renseigner selon instructions de la Confédération. Coordonnée x,y en mm à partir du coin haut - gauche -->
		<Position>18,285</Position>
	</Reference>
	<!-- Contenu du pied-de-page (page courante) -->
	<PageNumber>
		<FontSize>6</FontSize>
		<Format>Page {0}/{1}</Format>
		<Alignement>right</Alignement>
		<Position>192,285</Position>
	</PageNumber>
  <Municipality>
    <FontSize>6</FontSize>
    <Alignement>center</Alignement>
    <Position>130,25</Position>
  </Municipality>
</Template>