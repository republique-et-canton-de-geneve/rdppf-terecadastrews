<?xml version="1.0" encoding="utf-8" ?>
<!-- $Rev: 19053 $ -->
<Template>
    <!-- Format du rapport, valeurs possibles: A5, A4, A3 -->
    <Format>A4</Format>
    <!-- Marges utilisées pour le contenu du rapport (en mm), gauche, droite, haut, bas séparées par des virgules, sans espace -->
    <!-- Soustraire 3mm à la marge du haut pour afficher les titres à la bonne hauteur -->
    <Margins>18,18,37,15</Margins> 
    <!-- Utiliser le modèle définit dans web.config, valeurs possibles: true, false-->
    <UseModel>true</UseModel>
    <!-- Police utilisée pour les zones de texte -->
    <Font>
        <!-- Répertoire contenant la police -->
        <Directory>C:\Windows\Fonts</Directory>
        <Name>Cadastra</Name>
    </Font>
    <!-- Liste des zones de textes pour afficher la date courante -->
    <TextDateZones>
        <TextDateZone>
            <!-- Format de la date, notation courante: y (année), M (mois) , d (jour), H (heure), m (minute), s (seconde) -->
            <Text>dd.MM.yyyy HH:mm:ss</Text>
            <!-- Taille de la police -->
            <FontSize>7</FontSize>
            <!-- Alignement du text, valeurs possibles: left, center, right -->
            <Alignement>left</Alignement>
            <!-- Position verticale (en mm), valeurs possibles de l'attribut 'from' : left, right -->
            <HorizontalPosition from="left">18</HorizontalPosition>
            <!-- Position horizontale (en mm), valeurs possibles de l'attribut 'from' : top, bottom -->
            <VerticalPosition from="bottom">12</VerticalPosition>
            <!-- Rotation en degrés -->
            <Rotation>0</Rotation>
            <!-- Couleur de la police: rouge,vert,bleu (0 à 255) séparés par des virgules sans espace -->
            <Color>0,0,0</Color>
        </TextDateZone>
    </TextDateZones>
    <!-- Liste des zones de textes pour afficher le numéro de page courant -->
    <TextPageZones>
        <!-- Voir commentaires précédents pour les paramètres communs -->
        <TextPageZone>
            <!-- Format du text à afficher, le programme gère la présence des variables {0} et {1}, 
            {0} représente la page courante, {1} le nombre total de pages 
            exemples: "Pg. {0}", "Page {0}/{1}" -->
            <Text>Page {0}/{1}</Text>
            <FontSize>7</FontSize>
            <Alignement>right</Alignement>
            <HorizontalPosition from="right">18</HorizontalPosition>
            <VerticalPosition from="bottom">12</VerticalPosition>
            <Rotation>0</Rotation>
            <Color>0,0,0</Color>
        </TextPageZone>
    </TextPageZones>
    <!-- Liste des zones de texte non formatté -->
    <TextZones>
        <!-- Voir commentaires précédents pour les paramètres communs -->
        <TextZone>
            <!-- Référence du rapport -->
            <Text>#REF#</Text>
            <FontSize>7</FontSize>
            <Alignement>left</Alignement>
            <HorizontalPosition from="left">44</HorizontalPosition>
            <VerticalPosition from="bottom">12</VerticalPosition>
            <Rotation>0</Rotation>
            <Color>0,0,0</Color>
        </TextZone>
    </TextZones>
    <!-- Liste des zones de textes pour afficher le titre de l'annexe -->
    <TextAnnexZones>
        <!-- Voir commentaires précédents pour les paramètres communs -->
        <TextAnnexZone>
            <!-- Format du text à afficher, le programme gère la présence d'une variable {0} 
            représentant le numéro de l'annexe, 
            exemple: "Annexe {0}" -->
            <Text>Annexe {0}</Text>
            <FontSize>14</FontSize>
            <Alignement>left</Alignement>
            <HorizontalPosition from="left">18</HorizontalPosition>
            <VerticalPosition from="top">50</VerticalPosition>
            <Rotation>0</Rotation>
            <Color>0,0,0</Color>
        </TextAnnexZone>
    </TextAnnexZones>
</Template>